{
  "name": "personal-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm typecheck && next build --webpack && node scripts/prepare-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource-variable/mulish": "^5.3.0",
    "@fontsource/philosopher": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.0.320",
    "@types/node": "26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
