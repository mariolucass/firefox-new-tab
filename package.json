{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-brand-catalog.mjs && next dev --hostname 127.0.0.1",
    "deploy:ext": "node scripts/deploy-extension.mjs",
    "build": "node scripts/generate-brand-catalog.mjs && pnpm typecheck && next build --webpack && node scripts/prepare-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource-variable/brygada-1918": "^5.3.0",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^1.70.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
