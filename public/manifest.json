{
  "manifest_version": 3,
  "name": "Nexo",
  "description": "Nova aba local para atalhos, contextos e prioridades.",
  "version": "0.2.0",
  "chrome_url_overrides": { "newtab": "index.html" },
  "permissions": ["storage", "topSites", "sessions", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
